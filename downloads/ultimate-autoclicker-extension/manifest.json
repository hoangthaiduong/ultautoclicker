{
  "manifest_version": 3,
  "name": "Ultimate Autoclicker",
  "version": "1.2.5",
  "description": "A transparent, user-controlled click workflow assistant for browser pages.",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "commands"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_title": "Ultimate Autoclicker",
    "default_popup": "popup/popup.html"
  },
  "commands": {
    "start-or-resume": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Start or resume the Quick Click point cycle"
    },
    "pause-workflow": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause the selected workflow"
    },
    "stop-workflow": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "Stop the selected workflow"
    },
    "toggle-floating-control": {
      "description": "Show or hide the floating control (default page shortcut: Alt+C)"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
